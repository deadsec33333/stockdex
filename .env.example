# Nothing here is required. The site ships with working defaults and reads the
# Pons tables (pons_*) of the shared Supabase project. Set a value only to override.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_TABLE_PREFIX=
NEXT_PUBLIC_BRAND_NAME=stockdex
NEXT_PUBLIC_BOT_HANDLE=stockdexapp
# Optional: display limits only when they match your running backend.
NEXT_PUBLIC_DAILY_USER_LIMIT=
NEXT_PUBLIC_DAILY_GLOBAL_LIMIT=
# Optional: the official coin contract shown in the CA bar.
NEXT_PUBLIC_TOKEN_CA=
