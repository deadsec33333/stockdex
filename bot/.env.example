# ===== Brand =====
BRAND_NAME=YourBrand
BOT_HANDLE=YourBotHandle          # X handle of the bot, without @
SITE_URL=https://yourdomain.app

# ===== X (Twitter) API, pay per use =====
X_BEARER_TOKEN=                   # app bearer token (reads mentions)
X_BOT_USER_ID=                    # numeric user id of the bot account
X_API_KEY=                        # OAuth 1.0a keys (to post replies as the bot)
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
X_REPLY_ENABLED=false             # keep false until you test

# ===== Supabase =====
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=        # server only, NEVER put in the frontend

# ===== Pinata (IPFS for coin images + metadata) =====
PINATA_JWT=

# ===== PumpPortal Lightning API =====
PUMPPORTAL_API_KEY=               # the API key is tied to a PumpPortal wallet; this wallet pays for launches and receives creator fees
DEV_BUY_SOL=0                     # initial buy on launch (0 = none)
PRIORITY_FEE_SOL=0.0005

# ===== Solana =====
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
PAYOUT_WALLET_SECRET=             # base58 secret of the wallet that pays holders (only for fees:pay)

# ===== Safety limits =====
DRY_RUN=true                      # true = parse + save, but do not launch real coins
MAX_LAUNCHES_PER_USER_PER_DAY=3
MAX_LAUNCHES_PER_DAY=50
POLL_SECONDS=30
